# SwingPilot — plantilla de .env (copiar a .env; .env nunca se versiona).
# Se lee con swingpilot.security.CredentialVault; no exportar estas variables al entorno.

# Anthropic (solo AI Provider Adapter)
ANTHROPIC_API_KEY=

# Binance Spot (solo Execution Engine). Permisos: lectura + trading Spot; SIN retiro,
# sin margin/futuros; restringida por IP (REQ-G-093).
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Telegram (solo Telegram Bot; REQ-G-033)
TELEGRAM_BOT_TOKEN=
