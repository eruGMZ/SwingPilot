# Secretos y configuración local (tokens de Telegram, API keys del exchange)
.env
.env.*
!.env.example

# Python: caché y binarios compilados
__pycache__/
*.py[cod]
*$py.class

# Entornos virtuales
venv/
.venv/
.venv-*/
env/
ENV/

# Tests y herramientas de análisis
.pytest_cache/
.coverage
htmlcov/
.tox/

# Logs y archivos generados en ejecución
*.log
bot.log
rsi_cache.json

# Estado persistente del bot y archivos temporales de escritura
state.json
.state-*.tmp

# Base de datos de operaciones (historial auditable)
trades.db

# Editores y sistema operativo
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
.venv/
.pytest_cache/

# Datos locales de ejecución (presupuesto de IA, registros)
var/

# Bloqueo del registro de experimentos (QA3R2-03) y manifiesto temporal de snapshot (QA3R2-02)
research/experiments/*.lock
research/snapshots/*.json.tmp
